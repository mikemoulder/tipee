# ─────────────────────────────────────────────────────────────
# Copy to .env and fill in. .env is gitignored.
# ─────────────────────────────────────────────────────────────

# API (packages/api) ─────────────────────────────────────────
# The relayer: pays every fee, deploys gifter wallets, funds the faucet.
# Must be the account whose address is RELAYER_ADDRESS in packages/shared/src/stellar.ts.
RELAYER_SECRET=
# The escrow's verifier: the only key that can call escrow.claim.
VERIFIER_SECRET=
# Optional.
TREASURY_ADDRESS=
DATABASE_URL=
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
FAUCET_AMOUNT=10
PORT=3000

# Extension build (packages/extension) ───────────────────────
# Baked into the extension so a fresh install needs no Settings visit.
VITE_TIPEE_API=http://localhost:3000

# Website build (packages/web) ───────────────────────────────
NEXT_PUBLIC_TIPEE_API=http://localhost:3000
