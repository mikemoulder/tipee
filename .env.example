# ─────────────────────────────────────────────────────────────
# Copy to .env and fill in. .env is gitignored.
# ─────────────────────────────────────────────────────────────

# Arc testnet ────────────────────────────────────────────────
# RPC endpoint. Required by scripts/verify-chain.mjs.
ARC_RPC_URL=

# Expected chain ID (decimal). The probe warns if the RPC disagrees.
ARC_CHAIN_ID=

# Block explorer base URL, e.g. https://explorer.arc-testnet.example
# Used to build "view transaction" links in the composer.
ARC_EXPLORER_URL=

# ERC-20 USDC contract address, IF one exists on Arc alongside native USDC.
# Leave blank if USDC is purely the native gas currency — the probe will
# tell you which case you're in.
USDC_ADDRESS=

# Any address holding testnet funds. Optional, but lets the probe report
# real balances and produce a live gas estimate rather than a synthetic one.
PROBE_ADDRESS=


# Circle Programmable Wallets (Developer Controlled) ─────────
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
# Created once, then reused for every creator escrow wallet.
CIRCLE_WALLET_SET_ID=
# Circle's code for the chain escrow wallets live on. Defaults to ARC-TESTNET,
# which is the only Arc network Circle currently supports.
CIRCLE_BLOCKCHAIN=ARC-TESTNET

# Circle console app id, for the browser SDK. Not a secret, but environment-specific.
CIRCLE_APP_ID=
NEXT_PUBLIC_CIRCLE_APP_ID=

# Backend ────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tipee
PORT=3000

# Origin the extension is allowed to call, and which goes in
# the manifest's host_permissions so the service worker skips CORS.
API_ORIGIN=http://localhost:3000

# Platform ───────────────────────────────────────────────────
# Destination for the 4% withdrawal fee.
TREASURY_ADDRESS=
