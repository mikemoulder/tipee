{
  "manifest_version": 3,
  "name": "Tipee",
  "version": "0.1.0",
  "description": "Tip YouTube creators in USDC on Arc testnet.",
  "action": {
    "default_title": "Tipee Wallet",
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"]
}
